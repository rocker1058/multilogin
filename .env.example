# Copia este archivo a .env y rellena los valores reales.
# NO subas el .env real a git (contiene tu token de Multilogin).

WORKSPACE_ID=tu-workspace-id
FOLDER_ID=tu-folder-id
PROFILE_ID=tu-profile-id

# Token de automatización de Multilogin (larga duración).
# Genéralo en la app/panel de Multilogin. NO lo compartas ni lo subas a git.
MULTILOGIN_TOKEN=tu-token-de-automatizacion

# Opcional: forzar host del launcher.
# Si se omite:
#   - En WSL se detecta la IP de Windows automáticamente.
#   - Fuera de WSL usa 127.0.0.1.
# MLX_LAUNCHER=https://172.21.96.1:45001
